# Free keys: https://alpaca.markets  (sign up -> Paper Trading -> API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# "iex" is free; "sip" needs a paid data plan
ALPACA_DATA_FEED=iex

WATCHLIST=QQQ,SPY,VOO,AAPL,MSFT,NVDA,AMZN,TSLA
TIMEFRAME=15Min
SHORT_WINDOW=20
LONG_WINDOW=50
STARTING_CASH=10000
SLIPPAGE_PCT=0.05
DB_PATH=paper_trades.db
