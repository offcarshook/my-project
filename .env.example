# Alpaca PAPER trading keys: https://alpaca.markets -> Paper Trading -> API Keys.
# Placeholders only. Never commit real keys (.env is git-ignored).
ALPACA_API_KEY=your-paper-key-id
ALPACA_SECRET_KEY=your-paper-secret-key

# Optional. The bot only ever trades against https://paper-api.alpaca.markets and refuses
# to start if this points anywhere else.
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Settings below are only used by the Streamlit dashboard (app.py) ---
# "iex" is free real time; "sip" history is free with a 15-minute delay
ALPACA_DATA_FEED=iex
WATCHLIST=QQQ,SPY,IWM,DIA,XLK,SMH,TQQQ,SQQQ,SOXL,VOO
TIMEFRAME=5Min
STARTING_CASH=25000
SLIPPAGE_PCT=0.02
DB_PATH=paper_trades.db
